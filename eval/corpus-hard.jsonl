{"id":"hard-007","html":"<div id=\"o\"></div><script>document.getElementById(\"o\").innerHTML = localStorage.getItem(\"bio\");</script>","note":"存储型 XSS（持久化来源）","label":{"has_xss_risk":true,"risk_level":"HIGH"}}
